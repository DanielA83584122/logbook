# Optional override for the GitHub link in the page controls.
VITE_REPOSITORY_URL=https://github.com/divyavenn/still

# Optional SQLite overrides. With a custom path, opt in to copying the bundled
# sample database the first time the app starts.
# STILL_DB_PATH=/absolute/path/to/still.sqlite3
# STILL_SEED_ON_FIRST_RUN=true

# Optional password-only gate. Keep the password out of source control.
# STILL_AUTH_ENABLED=true
# STILL_AUTH_PASSWORD=replace-with-a-long-random-password
