# Optional override for the GitHub link in the page controls.
VITE_REPOSITORY_URL=https://github.com/divyavenn/still

# Neon runtime traffic uses the pooled URL. Migrations and one-time imports use
# the matching direct URL because those operations require session affinity.
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/neondb?sslmode=require
POSTGRES_TEST_URL=postgresql://127.0.0.1:55432/still_test
